# Python environments and generated bytecode (keep .py source files)
venv/
.venv/
env/
ENV/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
*.egg
.eggs/

# JavaScript dependencies and build output
node_modules/
node_modules.backup*/
dist/
build/
.vite/
.cache/
coverage/

# Local configuration and secrets (keep shareable templates)
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Tool caches and temporary test artifacts
.ruff_cache/
.pytest_cache/
.mypy_cache/
.pytype/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
pytest-cache-files-*/
.test-tmp*/
test-results/
playwright-report/
*.log

# ADK sessions and local runtime state
.adk/

# Runtime artifacts — never commit dynamically onboarded repos
coordinator/repos/*/
coordinator/repos/list_apps.json
!coordinator/repos/example-application/
coordinator/repos/example-application/source/*
!coordinator/repos/example-application/source/.gitkeep
coordinator/repos/example-application/docs/modules/*
!coordinator/repos/example-application/docs/modules/.gitkeep

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
