# Observo Agent Configuration

# Project Settings
PROJECT_NAME=Observo
PROJECT_DESCRIPTION=AI-powered observability and code analysis agent

# Model Configuration
MODEL_NAME=gemini-2.0-flash
MODEL_PROVIDER=google



# API Configuration
# Add your API key below
GEMINI_API_KEY=AI......

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Agent Configurations
AGENT_TYPE=rootagent
ENABLE_CONTEXT_AGENT=true
ENABLE_CODEFIX_AGENT=true
ENABLE_GAPFINDER_AGENT=true

# Environment
DEBUG=false
LOG_LEVEL=INFO

